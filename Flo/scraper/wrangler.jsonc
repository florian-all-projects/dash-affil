// Worker « cana-scraper » (Phase 2 Cana canada) : collecte des catalogues -> D1.
// Déploiement : npx wrangler deploy, avec CLOUDFLARE_API_TOKEN et CLOUDFLARE_ACCOUNT_ID dans l'environnement
// (jamais commités ; voir secrets.enc).
{
  "name": "cana-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Pas d'URL publique *.workers.dev : elle afficherait le sous-domaine du compte (nom de Florian).
  // Le Worker ne tourne que par Cron Trigger.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "cana-catalog", "database_id": "b1792254-2898-4c6b-8175-4a7ad127d183" }
  ],
  // Plan gratuit : une tranche (1 page d'un shop) par minute ; au repos entre deux cycles (CYCLE_DAYS).
  // Plan Workers Paid : passer MODE à "full", cron "17 6 * * 1" et ajouter "limits": { "cpu_ms": 300000 }.
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "MODE": "step", "PER_PAGE": "40", "CYCLE_DAYS": "7", "MAX_ATTEMPTS": "3", "PAGE_DELAY_MS": "1500" },
  "observability": { "enabled": true }
}
