---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Postmark from "../components/Postmark.astro";
import Faq from "../components/Faq.astro";
import { t, r, fmtPrice, fmtDate, fmtStamp, CATEGORY_SLUGS, CATEGORY_ORDER, type Lang } from "../lib/i18n";
import { products, deals, categoryStats, activeShops, productsByShop, byPopularity, couponsForShop, exportedAt } from "../lib/catalog";
import { PROVINCES, cities, stores, cityName, provName, provSlug, provinceOf } from "../lib/geo";
import { pageContent } from "../lib/content";
import { SHORT_NAME, SHOP_FACTS } from "../data/shops-content";
import { faqLd, itemListLd } from "../lib/seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const other: Lang = lang === "en" ? "fr" : "en";
const site = Astro.site!.toString().replace(/\/$/, "");
const price = (c: number) => fmtPrice(c, lang);
const board = CATEGORY_ORDER.map((c) => ({ c, st: categoryStats(c) })).filter((x) => x.st && x.c !== "other");
const topDeals = deals(8);
const mostCompared = [...products].filter((p) => p.shopCount > 1).sort(byPopularity).slice(0, 8);
const content = pageContent("home", "home", lang);
const editionDate = fmtDate(exportedAt, lang);
const shopRows = activeShops
  .map((sh) => {
    const list = productsByShop(sh.slug);
    return { sh, n: list.length, from: Math.min(...list.map((p) => p.offers.find((o) => o.shop.slug === sh.slug)!.price)), cats: new Set(list.map((p) => p.category)).size, facts: SHOP_FACTS[sh.slug], coupon: couponsForShop(sh.slug)[0] };
  })
  .sort((a, b) => b.n - a.n);

const L = lang === "en"
  ? {
      title: `Buy Weed Online in Canada | Compare ${activeShops.length} Online Dispensaries`,
      desc: `Buy weed online in Canada for less: compare ${products.length.toLocaleString("en-CA")} products from ${activeShops.length} online dispensaries that deliver by mail. Prices checked every week, promo codes, delivery by city.`,
      h1: "Buy weed online in Canada",
      kicker: "The price comparator for every online dispensary",
      lede: `This catalogue reads the full menu of ${activeShops.length} online dispensaries and seed banks that ship across Canada, every week. ${products.length.toLocaleString("en-CA")} products, each listed with every shop that sells it, so you can order at the lowest price.`,
      browse: "Browse the catalogue",
      deals: "Biggest price cuts this week", dealsNote: "Discount compared with the regular price the shop itself displays.",
      compared: "Sold by several shops", comparedNote: "Same product, different prices: these are the items where comparing pays off.",
      shopsTitle: "Online dispensaries compared", shopsCols: ["Shop", "Products", "From", "Free shipping", "Payment", "Promo code"],
      review: "Review", none: "Not published",
      deliveryTitle: "Weed delivery across Canada", deliveryNote: `Online shops deliver by mail to every province. Each city page also lists the ${stores.length.toLocaleString("en-CA")} provincially licensed stores we found in official registries.`,
      provinces: "By province", topCities: "Popular cities", allCities: "All cities",
      catTitle: "Shop by category", items: "items",
    }
  : {
      title: "Acheter du cannabis en ligne au Canada : le comparateur de prix",
      desc: `Achetez du cannabis en ligne au Canada au meilleur prix : comparez ${products.length.toLocaleString("fr-CA")} produits de ${activeShops.length} boutiques en ligne qui livrent par la poste. Prix vérifiés chaque semaine, codes promo, livraison par ville.`,
      h1: "Acheter du cannabis en ligne au Canada",
      kicker: "Le comparateur de toutes les boutiques en ligne",
      lede: `Ce catalogue lit chaque semaine le menu complet de ${activeShops.length} boutiques en ligne et banques de graines qui livrent partout au Canada. ${products.length.toLocaleString("fr-CA")} produits, chacun avec toutes les boutiques qui le vendent, pour commander au prix le plus bas.`,
      browse: "Parcourir le catalogue",
      deals: "Les plus fortes baisses de la semaine", dealsNote: "Remise calculée sur le prix habituel affiché par la boutique elle-même.",
      compared: "Vendus par plusieurs boutiques", comparedNote: "Même produit, prix différents : c'est ici que comparer rapporte.",
      shopsTitle: "Les boutiques en ligne comparées", shopsCols: ["Boutique", "Produits", "Dès", "Livraison gratuite", "Paiement", "Code promo"],
      review: "Avis", none: "Non publié",
      deliveryTitle: "Livraison de cannabis partout au Canada", deliveryNote: `Les boutiques en ligne livrent par la poste dans toutes les provinces. Chaque page ville liste aussi les ${stores.length.toLocaleString("fr-CA")} magasins autorisés par les provinces que nous avons trouvés dans les registres officiels.`,
      provinces: "Par province", topCities: "Villes les plus demandées", allCities: "Toutes les villes",
      catTitle: "Acheter par catégorie", items: "produits",
    };
const jsonld = [
  itemListLd(site, L.deals, topDeals.map((p) => r.product(lang, p.slug))),
  ...(content?.faq?.length ? [faqLd(content.faq)] : []),
];
---
<Base lang={lang} title={L.title} description={L.desc} path={r.home(lang)} alt={r.home(other)} jsonld={jsonld}>
  <section class="band border-b border-line">
    <div class="wrap grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:py-14">
      <div>
        <Postmark class="text-mailbox -rotate-6" top={lang === "en" ? "WEEKLY EDITION" : "ÉDITION HEBDO"} date={fmtStamp(exportedAt, lang)} bottom={lang === "en" ? "ALL OF CANADA" : "TOUT LE CANADA"} size={118} />
        <h1 class="mt-5">{L.h1}</h1>
        <p class="display mt-2 text-2xl text-mailbox">{L.kicker}</p>
        <p class="lede mt-4">{content?.lead ?? L.lede}</p>
        <a href={r.catalogue(lang)} class="btn-buy mt-6 px-6 py-3 text-base">{L.browse}</a>
      </div>
      <div>
        <p class="sr-only">{L.catTitle}</p>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {board.map(({ c, st }) => (
            <li>
              <a href={r.category(lang, c)} class="card no-underline">
                <div class="card-media"><img src={`/img/cat/${c}.webp`} alt="" width="704" height="704" class="cover" loading="eager" />
                  <span class="card-stamp stamp"><span class="stamp-label">{s.from}</span><span class="stamp-price">{price(st!.from)}</span></span></div>
                <div class="p-3 pt-4"><p class="display text-2xl leading-none">{CATEGORY_SLUGS[c].label[lang]}</p><p class="text-xs text-muted num">{st!.count.toLocaleString(lang === "en" ? "en-CA" : "fr-CA")} {L.items}</p></div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="wrap">
    {topDeals.length > 0 && (
      <section class="section">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><h2>{L.deals}</h2><p class="mt-1 text-sm text-muted">{L.dealsNote}</p></div>
          <a href={r.deals(lang)} class="text-sm font-semibold text-mailbox">{s.nav.deals}</a>
        </div>
        <div class="grid-products mt-6">{topDeals.map((p) => <ProductCard p={p} lang={lang} showCategory />)}</div>
      </section>
    )}

    {mostCompared.length > 0 && (
      <section class="section">
        <h2>{L.compared}</h2>
        <p class="mt-1 text-sm text-muted">{L.comparedNote}</p>
        <div class="grid-products mt-6">{mostCompared.map((p) => <ProductCard p={p} lang={lang} showCategory />)}</div>
      </section>
    )}

    <section class="section">
      <h2>{L.shopsTitle}</h2>
      <div class="mt-5 overflow-x-auto">
        <table class="table-bb min-w-[52rem]">
          <thead><tr>{L.shopsCols.map((c) => <th>{c}</th>)}<th class="sr-only">{L.review}</th></tr></thead>
          <tbody>
            {shopRows.map(({ sh, n, from, facts, coupon }) => (
              <tr>
                <td><a href={r.shop(lang, sh.slug)} class="font-semibold">{sh.name}</a></td>
                <td class="num">{n.toLocaleString(lang === "en" ? "en-CA" : "fr-CA")}</td>
                <td class="num font-semibold">{price(from)}</td>
                <td class="text-sm">{facts?.freeShipping?.[lang] ?? <span class="text-muted">{L.none}</span>}</td>
                <td class="text-sm">{facts?.payment?.[lang] ?? <span class="text-muted">{L.none}</span>}</td>
                <td>{coupon ? <a href={r.coupon(lang, sh.slug)} class="font-semibold text-mailbox">{coupon.code}</a> : <span class="text-muted">-</span>}</td>
                <td class="text-right"><a href={r.shop(lang, sh.slug)} class="btn-ghost text-sm">{L.review}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>{L.deliveryTitle}</h2>
      <p class="lede mt-2">{L.deliveryNote}</p>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        <div class="parcel">
          <p class="parcel-head">{L.provinces}</p>
          <ul class="grid grid-cols-1 gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
            {PROVINCES.map((p) => <li class="flex justify-between gap-2"><a href={r.province(lang, provSlug(p, lang))}>{provName(p, lang)}</a><span class="num text-muted">{p.age}+</span></li>)}
          </ul>
        </div>
        <div>
          <p class="display text-2xl">{L.topCities}</p>
          <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 sm:grid-cols-3">
            {cities.slice(0, 24).map((c) => <li><a href={r.city(lang, provSlug(provinceOf(c.province), lang), c.slug)} class="font-semibold">{cityName(c, lang)}</a></li>)}
          </ul>
          <a href={r.delivery(lang)} class="mt-4 inline-block text-sm font-semibold text-mailbox">{L.allCities}</a>
        </div>
      </div>
    </section>

    {content && (
      <section class="section">
        <article class="prose-bb">
          {content.sections.map((sec) => (<><h2>{sec.h}</h2>{sec.p.map((x) => <p>{x}</p>)}</>))}
        </article>
      </section>
    )}
    {content?.faq && <Faq items={content.faq} title={s.faqTitle} />}
  </div>
</Base>
