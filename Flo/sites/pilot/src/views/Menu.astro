---
import Base from "../layouts/Base.astro";
import { t, r, fmtPrice, fmtDate, CATEGORY_SLUGS, CATEGORY_ORDER, type Lang } from "../lib/i18n";
import { categoryStats, exportedAt, products } from "../lib/catalog";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const cats = CATEGORY_ORDER.map((c) => ({ c, st: categoryStats(c) })).filter((x) => x.st);
const title = lang === "en" ? `The menu: ${products.length} cannabis products compared across Canadian online shops` : `Le menu : ${products.length} produits de cannabis comparés dans les boutiques en ligne canadiennes`;
const lede = lang === "en"
  ? "Every product we found in stock this week, grouped the way a dispensary menu is. Open a category to see each product at its lowest price."
  : "Tous les produits trouvés en stock cette semaine, rangés comme le menu d'un dispensaire. Ouvrez une catégorie pour voir chaque produit à son prix le plus bas.";
---
<Base lang={lang} title={title} description={lede} path={r.menu(lang)} alt={r.menu(lang === "en" ? "fr" : "en")}>
  <div class="wrap pt-8">
    <h1 class="text-5xl md:text-6xl">{s.nav.menu}</h1>
    <p class="mt-3 max-w-2xl text-moss">{lede}</p>
    <p class="mt-1 text-xs text-moss">{s.updated(fmtDate(exportedAt, lang))}</p>
    <ul class="mt-8 divide-y divide-lichen border-y border-lichen">
      {cats.map(({ c, st }) => (
        <li class="py-5 grid grid-cols-[4rem_1fr_auto] gap-4 items-center">
          <img src={`/img/cat/${c}.webp`} alt="" width="64" height="64" class="w-16 h-16 rounded-md object-cover" loading="lazy" />
          <div>
            <a href={r.category(lang, c)} class="display text-3xl text-spruce no-underline hover:text-leaf">{CATEGORY_SLUGS[c].label[lang]}</a>
            <p class="text-sm text-moss mt-1">{s.productsCount(st!.count)}, {s.shopsCount(st!.shops)}</p>
          </div>
          <p class="num text-right"><span class="text-xs text-moss">{s.from}</span> <span class="display text-3xl text-copper">{fmtPrice(st!.from, lang)}</span></p>
        </li>
      ))}
    </ul>
  </div>
</Base>
