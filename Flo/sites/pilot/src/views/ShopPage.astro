---
// Fiche boutique (« avis ») : uniquement des faits relevés (catalogue, prix, conditions publiées) + texte généré à partir de ces faits.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProductCard from "../components/ProductCard.astro";
import Faq from "../components/Faq.astro";
import { t, r, fmtPrice, fmtDate, CATEGORY_SLUGS, CATEGORY_ORDER, type Lang } from "../lib/i18n";
import { shops, productsByShop, couponsForShop, showcase, exportedAt } from "../lib/catalog";
import { pageContent } from "../lib/content";
import { SHORT_NAME, SHOP_INTRO, SHOP_FACTS } from "../data/shops-content";
import { title as mkTitle, breadcrumbLd, faqLd } from "../lib/seo";

interface Props { lang: Lang; shop: string }
const { lang, shop } = Astro.props;
const sh = shops.find((x) => x.slug === shop)!;
const s = t[lang];
const other: Lang = lang === "en" ? "fr" : "en";
const site = Astro.site!.toString().replace(/\/$/, "");
const price = (c: number) => fmtPrice(c, lang);
const list = productsByShop(shop);
const own = (p: (typeof list)[number]) => p.offers.find((o) => o.shop.slug === shop)!;
const prices = list.map((p) => own(p).price);
const cats = CATEGORY_ORDER.map((c) => ({ c, n: list.filter((p) => p.category === c).length })).filter((x) => x.n);
const cheapestHere = list.filter((p) => p.offers[0].shop.slug === shop).length;
const shared = list.filter((p) => p.shopCount > 1).length;
const top = showcase(list, 12);
const coupons = couponsForShop(shop);
const facts = SHOP_FACTS[shop];
const content = pageContent("shop", shop, lang);
const short = SHORT_NAME[shop] ?? sh.name;
const L = lang === "en"
  ? { h1: `${sh.name} Review`, kicker: "Prices, catalogue, delivery and promo codes", title: mkTitle(`${sh.name} Review: Prices, Delivery & Promo Codes`, `${sh.name} Review & Promo Codes`), desc: `${sh.name} review: ${list.length} products from ${price(Math.min(...prices))}, ${facts?.shipping?.en ?? "delivery across Canada"} Prices compared with other online dispensaries every week.`, sheet: "Shop sheet", products: "Products in stock", range: "Price range", cheapest: "Cheapest shop for", sharedL: "Products also sold elsewhere", ship: "Shipping", free: "Free shipping", pay: "Payment", aff: "Affiliate link", lifetime: "Yes, commission for life on referred customers", catsT: `What ${short} sells`, topT: `Popular at ${short}`, couponT: `${short} promo codes`, visit: `Visit ${short}`, source: "Delivery and payment terms read on the shop's site", none: "Not published", all: "See all" }
  : { h1: `Avis ${sh.name}`, kicker: "Prix, catalogue, livraison et codes promo", title: mkTitle(`Avis ${sh.name} : prix, livraison et codes promo`, `Avis ${sh.name} et codes promo`), desc: `Avis ${sh.name} : ${list.length} produits dès ${price(Math.min(...prices))}, ${facts?.shipping?.fr ?? "livraison partout au Canada"} Prix comparés chaque semaine avec les autres boutiques en ligne.`, sheet: "Fiche boutique", products: "Produits en stock", range: "Fourchette de prix", cheapest: "Boutique la moins chère pour", sharedL: "Produits vendus aussi ailleurs", ship: "Envoi", free: "Livraison gratuite", pay: "Paiement", aff: "Lien affilié", lifetime: "Oui, commission à vie sur les clients recommandés", catsT: `Ce que vend ${short}`, topT: `Les produits populaires chez ${short}`, couponT: `Codes promo ${short}`, visit: `Visiter ${short}`, source: "Conditions de livraison et de paiement lues sur le site de la boutique", none: "Non publié", all: "Tout voir" };
const crumbs = [{ name: s.breadcrumbHome, href: r.home(lang) }, { name: s.nav.shops, href: r.shops(lang) }, { name: sh.name }];
const jsonld = [
  breadcrumbLd(site, crumbs),
  { "@context": "https://schema.org", "@type": "OnlineStore", name: sh.name, url: `https://${sh.domain}/` },
  ...(content?.faq?.length ? [faqLd(content.faq)] : []),
];
---
<Base lang={lang} title={L.title} description={L.desc} path={r.shop(lang, shop)} alt={r.shop(other, shop)} jsonld={jsonld}>
  <section class="band border-b border-line">
    <div class="wrap grid gap-8 py-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:py-12">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1 class="mt-4">{L.h1}</h1>
        <p class="display mt-2 text-2xl text-mailbox">{L.kicker}</p>
        <p class="lede mt-4">{content?.lead ?? SHOP_INTRO[shop]?.[lang]}</p>
        <a href={sh.affiliate_url ?? `https://${sh.domain}/`} rel="sponsored nofollow noopener" target="_blank" class="btn-buy mt-6 px-6 py-3">{L.visit}</a>
      </div>
      <div class="parcel self-start">
        <p class="parcel-head">{L.sheet}</p>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
          <dt class="font-semibold">{L.products}</dt><dd class="num">{list.length}</dd>
          <dt class="font-semibold">{L.range}</dt><dd class="num">{price(Math.min(...prices))} – {price(Math.max(...prices))}</dd>
          <dt class="font-semibold">{L.cheapest}</dt><dd class="num">{cheapestHere} {lang === "en" ? "products" : "produits"}</dd>
          <dt class="font-semibold">{L.sharedL}</dt><dd class="num">{shared}</dd>
          <dt class="font-semibold">{L.ship}</dt><dd>{facts?.shipping?.[lang] ?? <span class="text-muted">{L.none}</span>}</dd>
          <dt class="font-semibold">{L.free}</dt><dd>{facts?.freeShipping?.[lang] ?? <span class="text-muted">{L.none}</span>}</dd>
          <dt class="font-semibold">{L.pay}</dt><dd>{facts?.payment?.[lang] ?? <span class="text-muted">{L.none}</span>}</dd>
        </dl>
        <p class="mt-3 text-xs text-muted">{s.updated(fmtDate(exportedAt, lang))}. {facts && <>{L.source} (<a href={facts.source} rel="nofollow noopener">{new URL(facts.source).hostname}</a>).</>}</p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <h2>{L.catsT}</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {cats.map(({ c, n }) => <li><a href={r.category(lang, c)} class="btn-ghost text-sm">{CATEGORY_SLUGS[c].label[lang]} <span class="ml-1 text-muted num">{n}</span></a></li>)}
      </ul>
    </section>

    {coupons.length > 0 && (
      <section class="section">
        <div class="parcel max-w-2xl">
          <p class="parcel-head">{L.couponT}</p>
          <ul class="space-y-2">{coupons.map((c) => <li><b class="display text-2xl tracking-wide">{c.code}</b> <span class="text-sm">{c.description}</span></li>)}</ul>
          <a href={r.coupon(lang, shop)} class="mt-3 inline-block text-sm font-semibold text-mailbox">{L.all}</a>
        </div>
      </section>
    )}

    <section class="section">
      <h2>{L.topT}</h2>
      <div class="grid-products mt-6">{top.map((p) => <ProductCard p={p} lang={lang} showCategory />)}</div>
    </section>

    {content && (
      <section class="section">
        <article class="prose-bb">
          {content.sections.map((sec, i) => (<><h2 class:list={[i === 0 && "!mt-0"]}>{sec.h}</h2>{sec.p.map((x) => <p>{x}</p>)}</>))}
        </article>
      </section>
    )}
    {content?.faq && <Faq items={content.faq} title={s.faqTitle} />}
    <p class="mt-10 text-xs text-muted">{s.disclosure}</p>
  </div>
</Base>
