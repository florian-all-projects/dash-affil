---
// Rayon (catégorie) : en-tête chiffré, raccourcis par format, moteur de filtres complet, puis modules de lecture du marché
// (prix au gramme par boutique et par poids, répartition des types, meilleurs prix au gramme), guide en fiches et FAQ.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Explorer from "../components/Explorer.astro";
import Faq from "../components/Faq.astro";
import GuideBlocks from "../components/GuideBlocks.astro";
import HBars from "../components/viz/HBars.astro";
import ShareBar from "../components/viz/ShareBar.astro";
import { t, r, fmtPrice, fmtDate, CATEGORY_SLUGS, type Lang } from "../lib/i18n";
import { productsByCategory, categoryStats, byPopularity, exportedAt, shops, strains } from "../lib/catalog";
import { PAGE_SIZE } from "../lib/paths";
import { pageContent } from "../lib/content";
import { subtypeLabel } from "../lib/explore";
import { median, medianBy, ppgByFormat, shopsOf } from "../lib/stats";
import { SHORT_NAME } from "../data/shops-content";
import { title as mkTitle, breadcrumbLd, faqLd, itemListLd } from "../lib/seo";

interface Props { lang: Lang; cat: string; page: number }
const { lang, cat, page } = Astro.props;
const s = t[lang];
const en = lang === "en";
const other: Lang = en ? "fr" : "en";
const site = Astro.site!.toString().replace(/\/$/, "");
const C = CATEGORY_SLUGS[cat];
const list = productsByCategory(cat).sort(byPopularity);
const st = categoryStats(cat)!;
const pages = Math.ceil(list.length / PAGE_SIZE);
const items = list.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const content = pageContent("category", cat, lang);
const price = (c: number) => fmtPrice(c, lang);
const nf = (n: number) => n.toLocaleString(en ? "en-CA" : "fr-CA");

const NOUNS = {
  flower: { en: "Weed Flower", fr: "fleurs de cannabis" }, edible: { en: "Edibles", fr: "comestibles au cannabis" },
  concentrate: { en: "Concentrates", fr: "concentrés de cannabis" }, vape: { en: "Weed Vapes", fr: "vapoteuses au cannabis" },
  cbd: { en: "CBD Products", fr: "produits au CBD" }, seed: { en: "Cannabis Seeds", fr: "graines de cannabis" },
  accessory: { en: "Cannabis Accessories", fr: "accessoires de cannabis" }, other: { en: "Cannabis Topicals", fr: "topiques au cannabis" },
} as const;
const noun = NOUNS[cat as keyof typeof NOUNS] ?? { en: C.label.en, fr: C.label.fr.toLowerCase() };
const COUNTED = { flower: "flower strains", edible: "edibles", concentrate: "concentrates", vape: "vapes", cbd: "CBD products", seed: "seed packs", accessory: "accessories", other: "topicals" } as const;
const counted = COUNTED[cat as keyof typeof COUNTED] ?? "products";
const h1 = en ? `Buy ${noun.en} Online in Canada` : `Acheter des ${noun.fr} en ligne au Canada`;
const pageTitle = en
  ? mkTitle(`Buy ${noun.en} Online in Canada: ${st.count} Products Compared${page > 1 ? `, Page ${page}` : ""}`, `Buy ${noun.en} Online in Canada${page > 1 ? ` (p. ${page})` : ""}`)
  : mkTitle(`Acheter des ${noun.fr} en ligne au Canada${page > 1 ? `, page ${page}` : ""}`, `${C.label.fr} en ligne au Canada${page > 1 ? ` (p. ${page})` : ""}`);
const desc = en
  ? `Compare ${st.count} ${counted} from ${st.shops} Canadian online shops, from ${price(st.from)}. Filter by type, format, weight, price per gram and THC. Prices checked every week.`
  : `Comparez ${st.count} ${noun.fr} de ${st.shops} boutiques en ligne canadiennes, dès ${price(st.from)}. Filtres par type, format, poids, prix au gramme et THC. Prix vérifiés chaque semaine.`;
const crumbs = [{ name: s.breadcrumbHome, href: r.home(lang) }, { name: s.nav.catalogue, href: r.catalogue(lang) }, { name: C.label[lang] }];
const jsonld = [
  breadcrumbLd(site, crumbs),
  itemListLd(site, h1, items.map((p) => r.product(lang, p.slug))),
  ...(page === 1 && content?.faq?.length ? [faqLd(content.faq)] : []),
];

// Chiffres du rayon
const ppgs = list.map((p) => p.ppg).filter((v): v is number => !!v);
const medPpg = median(ppgs);
const medPrice = median(list.map((p) => p.from))!;
const nSale = list.filter((p) => p.discount > 0).length;
const tiles = [
  { label: en ? "Products in stock" : "Produits en stock", value: nf(st.count), note: s.shopsCount(st.shops) },
  { label: en ? "Lowest price" : "Prix le plus bas", value: price(st.from), note: st.cheapest.name },
  ppgs.length >= 12 ? { label: en ? "Median price per gram" : "Prix médian au gramme", value: `${price(medPpg!)}/g`, note: en ? `${nf(ppgs.length)} products with a weight` : `${nf(ppgs.length)} produits avec un poids` } : { label: en ? "Median price" : "Prix médian", value: price(medPrice), note: null },
  { label: en ? "On sale this week" : "En promotion cette semaine", value: nf(nSale), note: nSale ? `${Math.round((nSale / st.count) * 100)} %` : null },
];
// Raccourcis par format (sous-types) : liens vers le filtre correspondant
const subs = [...new Set(list.map((p) => p.subtype))].map((k) => ({ k, n: list.filter((p) => p.subtype === k).length })).filter((x) => x.n >= 3).sort((a, b) => b.n - a.n);
// Modules
const short = (sl: string) => SHORT_NAME[sl] ?? shops.find((x) => x.slug === sl)?.name ?? sl;
const ppgShop = ppgs.length >= 12 ? medianBy(list, shopsOf, (p) => p.ppg, 5) : [];
const priceShop = medianBy(list, shopsOf, (p) => p.from, 5);
const byFormat = ppgByFormat(list.filter((p) => !["shake", "preroll"].includes(p.subtype)));
const loFmt = byFormat.length > 1 ? byFormat.reduce((a, b) => (b.value < a.value ? b : a)) : null;
const fmtSave = loFmt && loFmt.grams !== byFormat[0].grams && loFmt.value < byFormat[0].value ? { pct: Math.round((1 - loFmt.value / byFormat[0].value) * 100), lo: String(loFmt.grams), hi: String(byFormat[0].grams) } : null;
const typeCounts = (["indica", "hybrid", "sativa"] as const).map((ty) => ({ ty, n: list.filter((p) => p.strainType === ty).length }));
const typed = typeCounts.reduce((a, x) => a + x.n, 0);
const cheapestPpg = list.filter((p) => p.ppg && !["shake", "preroll"].includes(p.subtype)).sort((a, b) => a.ppg! - b.ppg!).slice(0, 6);
const topStrains = strains.filter((x) => x.products.some((p) => p.category === cat)).slice(0, 12);
const qs = (k: string, v: string) => `${r.category(lang, cat)}?${k}=${encodeURIComponent(v)}`;
---
<Base lang={lang} title={pageTitle} description={desc} path={r.category(lang, cat, page)} alt={r.category(other, cat, page)} jsonld={jsonld}>
  <div class="band">
    <div class="wrap py-8">
      <Breadcrumbs items={crumbs} />
      <div class="mt-4 grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <h1>{h1}</h1>
          <p class="lede mt-3">{content?.lead ?? desc}</p>
        </div>
        <span class="stamp stamp-lg justify-self-start"><span class="stamp-label">{s.from}</span><span class="stamp-price">{price(st.from)}</span></span>
      </div>
      {page === 1 && (
        <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
          {tiles.map((x) => <div class="tile"><p class="tile-label">{x.label}</p><p class="tile-value">{x.value}</p>{x.note && <p class="tile-note truncate">{x.note}</p>}</div>)}
        </div>
      )}
      <p class="mt-4 text-sm text-muted">{s.updated(fmtDate(exportedAt, lang))}.</p>
      {subs.length > 1 && (
        <nav class="mt-4 flex flex-wrap gap-2" aria-label={en ? "Shop by format" : "Par format"}>
          {subs.map((x) => <a href={qs("sub", x.k)} class="rounded-full border border-ink/25 bg-white px-3 py-1 text-sm no-underline hover:border-ink">{subtypeLabel(x.k, lang)} <span class="text-xs text-muted num">{nf(x.n)}</span></a>)}
        </nav>
      )}
    </div>
  </div>

  <div class="wrap">
    <Explorer lang={lang} list={list} dataUrl={`/data/cat-${cat}.json`} pager={{ page, pages, href: (n) => r.category(lang, cat, n) }} hide={["cat"]} />

    {page === 1 && (
      <section class="section">
        <h2>{en ? `${C.label.en}: the market this week` : `${C.label.fr} : le marché cette semaine`}</h2>
        <div class="mt-5 grid gap-6 lg:grid-cols-2">
          {ppgShop.length > 1 && (
            <div class="panel">
              <h3 class="panel-title">{en ? "Median price per gram by shop" : "Prix médian au gramme par boutique"}</h3>
              <p class="panel-sub">{en ? "Best format of each product, shops with 5 products or more." : "Meilleur format de chaque produit, boutiques avec au moins 5 produits."}</p>
              <div class="mt-4"><HBars ariaLabel={en ? "Median price per gram by shop" : "Prix médian au gramme par boutique"} rows={ppgShop.map((x, i) => ({ label: short(x.key), value: x.value, display: `${price(x.value)}/g`, href: r.shop(lang, x.key), best: i === 0, note: `${x.n}` }))} /></div>
            </div>
          )}
          {ppgShop.length <= 1 && priceShop.length > 1 && (
            <div class="panel">
              <h3 class="panel-title">{en ? "Median price by shop" : "Prix médian par boutique"}</h3>
              <p class="panel-sub">{en ? "Lowest listed price of each product." : "Prix le plus bas de chaque produit."}</p>
              <div class="mt-4"><HBars ariaLabel={en ? "Median price by shop" : "Prix médian par boutique"} rows={priceShop.map((x, i) => ({ label: short(x.key), value: x.value, display: price(x.value), href: r.shop(lang, x.key), best: i === 0 }))} /></div>
            </div>
          )}
          {byFormat.length > 1 && (
            <div class="panel">
              <h3 class="panel-title">{en ? "Bigger bags, lower price per gram" : "Plus le sac est gros, moins le gramme coûte"}</h3>
              <p class="panel-sub">{en ? "Median price per gram for each weight, all shops." : "Prix médian au gramme pour chaque poids, toutes boutiques."}</p>
              <div class="mt-4"><HBars ariaLabel={en ? "Price per gram by weight" : "Prix au gramme selon le poids"} rows={byFormat.map((x) => ({ label: `${String(x.grams).replace(".", en ? "." : ",")} g`, value: x.value, display: `${price(x.value)}/g`, href: qs("fmt", String(x.grams)), best: x.value === Math.min(...byFormat.map((y) => y.value)) }))} /></div>
              {fmtSave && <p class="mt-3 text-sm"><b>{fmtSave.pct} %</b> {en ? `cheaper per gram at ${fmtSave.lo} g than at ${fmtSave.hi} g.` : `moins cher au gramme en ${fmtSave.lo.replace(".", ",")} g qu'en ${fmtSave.hi.replace(".", ",")} g.`}</p>}
            </div>
          )}
          {typed >= 20 && (
            <div class="panel">
              <h3 class="panel-title">{en ? "Indica, hybrid or sativa" : "Indica, hybride ou sativa"}</h3>
              <p class="panel-sub">{en ? `Type listed by the shop, ${nf(typed)} products.` : `Type indiqué par la boutique, ${nf(typed)} produits.`}</p>
              <div class="mt-4"><ShareBar lang={lang} ariaLabel={en ? "Share by type" : "Répartition par type"} parts={typeCounts.map((x) => ({ label: s.typeLabel[x.ty], n: x.n, color: `var(--color-${x.ty})`, href: qs("type", x.ty) }))} /></div>
            </div>
          )}
          {cheapestPpg.length >= 3 && (
            <div class="panel">
              <h3 class="panel-title">{en ? "Lowest price per gram" : "Les prix au gramme les plus bas"}</h3>
              {cat === "flower" && <p class="panel-sub">{en ? "Shake and pre-rolls excluded." : "Hors shake et préroulés."}</p>}
              <table class="table-bb mt-3">
                <thead><tr><th>{en ? "Product" : "Produit"}</th><th>{en ? "Format" : "Format"}</th><th>{en ? "Per gram" : "Au gramme"}</th></tr></thead>
                <tbody>
                  {cheapestPpg.map((p) => {
                    const f = p.formats.reduce((a, b) => (b.ppg < a.ppg ? b : a));
                    return <tr><td><a href={r.product(lang, p.slug)} class="font-semibold">{p.name}</a></td><td class="num">{f.label}</td><td class="num font-semibold">{price(p.ppg!)}/g</td></tr>;
                  })}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    )}

    {page === 1 && topStrains.length >= 4 && (
      <section class="section">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2>{en ? "Popular strains in this aisle" : "Variétés populaires de ce rayon"}</h2>
          <a href={r.strains(lang)} class="text-sm font-semibold text-mailbox">{en ? "All strains" : "Toutes les variétés"}</a>
        </div>
        <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
          {topStrains.map((x) => {
            const ps = x.products.filter((p) => p.category === cat);
            return <li><a href={r.strain(lang, x.slug)} class="block rounded-[4px] border border-line p-3 no-underline hover:border-ink"><span class="block font-semibold">{x.name}</span><span class="text-xs text-muted">{s.productsCount(ps.length)}, {s.from} {price(Math.min(...ps.map((p) => p.from)))}</span></a></li>;
          })}
        </ul>
      </section>
    )}

    {page === 1 && content && <GuideBlocks sections={content.sections} lang={lang} title={en ? `Buying ${noun.en.toLowerCase()} online: the guide` : `Acheter des ${noun.fr} en ligne : le guide`} />}
    {page === 1 && content?.faq && <Faq items={content.faq} title={s.faqTitle} />}
  </div>
</Base>
