---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProductCard from "../components/ProductCard.astro";
import Faq from "../components/Faq.astro";
import { t, r, fmtPrice, fmtDate, CATEGORY_SLUGS, CATEGORY_ORDER, type Lang } from "../lib/i18n";
import { products, categoryStats, activeShops, byPopularity, exportedAt, pick } from "../lib/catalog";
import { cities, provinceOf, cityName, provName, provSlug, nearby, NO_REGISTRY } from "../lib/geo";
import { pageContent } from "../lib/content";
import { title as mkTitle, breadcrumbLd, faqLd } from "../lib/seo";

interface Props { lang: Lang; cityKey: string }
const { lang, cityKey } = Astro.props;
const city = cities.find((c) => `${c.province}/${c.slug}` === cityKey)!;
const prov = provinceOf(city.province);
const s = t[lang];
const other: Lang = lang === "en" ? "fr" : "en";
const site = Astro.site!.toString().replace(/\/$/, "");
const price = (c: number) => fmtPrice(c, lang);
const name = cityName(city, lang);
const pName = provName(prov, lang);
const n = city.stores.length;
const content = pageContent("city", cityKey, lang);
const board = CATEGORY_ORDER.map((c) => ({ c, st: categoryStats(c) })).filter((x) => x.st && x.c !== "other");
// Sélection propre à chaque ville (variation stable) parmi les produits les plus comparés
// 2 produits par catégorie (fleurs, comestibles, concentrés, vapoteuses), une seule fois par marque, décalage propre à la ville
const seed = city.slug.split("").reduce((a, ch) => a + ch.charCodeAt(0), 0);
const brand = (n: string) => n.split(/\s[–-]\s/)[0].toLowerCase();
const picks = ["flower", "edible", "concentrate", "vape"].flatMap((cat, ci) => {
  const pool = products.filter((p) => p.category === cat && p.image.kind !== "category").sort(byPopularity).slice(0, 120);
  const seen = new Set<string>();
  const out: typeof pool = [];
  for (let i = 0; i < pool.length && out.length < 2; i++) {
    const p = pool[(seed * (ci + 3) + i * 7) % pool.length];
    if (seen.has(brand(p.name))) continue;
    seen.add(brand(p.name));
    out.push(p);
  }
  return out;
});
const near = nearby(city, 10);
const SHOW = 40;

const L = lang === "en"
  ? {
      h1: `Weed Delivery in ${name}`,
      kicker: n ? `Online prices and the ${n} licensed cannabis store${n > 1 ? "s" : ""} in ${name}` : `Online prices and delivery rules in ${name}`,
      title: mkTitle(`Weed Delivery ${name}: Online Prices & ${n ? `${n} Dispensaries` : "Rules"} (${prov.code})`, `Weed Delivery ${name}, ${prov.code} | Prices & Dispensaries`),
      desc: `Weed delivery in ${name}, ${prov.name}: compare ${products.length.toLocaleString("en-CA")} products from ${activeShops.length} online shops${n ? ` and find the ${n} licensed cannabis stores in ${name}` : ""}. Legal age ${prov.age}+, prices checked weekly.`,
      label: `Delivery to ${name}, ${prov.code}`, age: "Legal age", shipping: "Online shops shipping here", storesL: "Licensed stores in the city", grow: "Home growing", growYes: "Allowed, up to 4 plants", growNo: "Not allowed",
      priceTitle: `Lowest online prices for delivery to ${name}`, priceNote: "Online prices are the same everywhere in Canada; shipping terms vary by shop.",
      picksTitle: `Popular picks delivered to ${name}`,
      storesTitle: `Cannabis stores in ${name}`, storesNote: "Stores authorized by the province. Hours and stock change: call before you go. Source:",
      addr: "Address", phone: "Phone", web: "Website", showAll: (k: number) => `Show all ${k} stores`,
      rules: `Cannabis rules in ${prov.name}`, rulesMore: `Everything about buying weed in ${prov.name}`, near: `Weed delivery near ${name}`,
      noStores: NO_REGISTRY.has(prov.code)
        ? `We have not loaded the official store list for ${prov.name} yet. Legal purchase in ${name} goes through ${prov.retailer}.`
        : prov.code === "NU" ? `Nunavut has no cannabis store open to the public: legal purchase goes through ${prov.retailer}.`
        : `We did not find a provincially licensed store located in ${name} in the official registry. ${prov.retailer[0].toUpperCase() + prov.retailer.slice(1)} remain the legal options.`,
    }
  : {
      h1: `Livraison de cannabis à ${name}`,
      kicker: n ? `Les prix en ligne et ${n > 1 ? `les ${n} magasins de cannabis autorisés` : "le magasin de cannabis autorisé"} à ${name}` : `Les prix en ligne et les règles de livraison à ${name}`,
      title: mkTitle(`Livraison de cannabis à ${name} : prix et ${n ? `${n} magasins` : "règles"} (${prov.code})`, `Cannabis ${name} : livraison, prix et magasins`),
      desc: `Livraison de cannabis à ${name} (${pName}) : comparez ${products.length.toLocaleString("fr-CA")} produits de ${activeShops.length} boutiques en ligne${n ? ` et trouvez les ${n} magasins de cannabis autorisés de ${name}` : ""}. Âge légal ${prov.age} ans, prix vérifiés chaque semaine.`,
      label: `Livraison à ${name}, ${prov.code}`, age: "Âge légal", shipping: "Boutiques en ligne qui livrent ici", storesL: "Magasins autorisés en ville", grow: "Culture à domicile", growYes: "Permise, jusqu'à 4 plants", growNo: "Interdite",
      priceTitle: `Les prix en ligne les plus bas pour une livraison à ${name}`, priceNote: "Les prix en ligne sont les mêmes partout au Canada ; les conditions d'envoi varient selon la boutique.",
      picksTitle: `Des produits populaires livrés à ${name}`,
      storesTitle: `Magasins de cannabis à ${name}`, storesNote: "Magasins autorisés par la province. Horaires et stocks changent : appelez avant de vous déplacer. Source :",
      addr: "Adresse", phone: "Téléphone", web: "Site web", showAll: (k: number) => `Voir les ${k} magasins`,
      rules: `Les règles du cannabis ${prov.inFr}`, rulesMore: `Tout savoir pour acheter du cannabis ${prov.inFr}`, near: `Livraison de cannabis près de ${name}`,
      noStores: NO_REGISTRY.has(prov.code)
        ? `Nous n'avons pas encore chargé la liste officielle des magasins ${prov.inFr}. À ${name}, l'achat légal passe par ${prov.retailerFr}.`
        : prov.code === "NU" ? `Le Nunavut n'a pas de magasin de cannabis ouvert au public : l'achat légal passe par ${prov.retailerFr}.`
        : `Nous n'avons pas trouvé de magasin autorisé situé à ${name} dans le registre officiel. ${prov.retailerFr[0].toUpperCase() + prov.retailerFr.slice(1)} restent les options légales.`,
    };
const crumbs = [
  { name: s.breadcrumbHome, href: r.home(lang) },
  { name: s.nav.delivery, href: r.delivery(lang) },
  { name: pName, href: r.province(lang, provSlug(prov, lang)) },
  { name },
];
const sourceLinks = [...new Map(city.stores.map((x) => [x.source, x.sourceUrl])).entries()];
const sources = sourceLinks.map(([n]) => n).join(", ");
const jsonld: object[] = [
  breadcrumbLd(site, crumbs),
  ...(n ? [{
    "@context": "https://schema.org", "@type": "ItemList", name: L.storesTitle,
    itemListElement: city.stores.slice(0, 100).map((st, i) => ({
      "@type": "ListItem", position: i + 1,
      item: {
        "@type": "Store", name: st.name,
        address: { "@type": "PostalAddress", streetAddress: st.address, addressLocality: city.name, addressRegion: prov.code, ...(st.postal ? { postalCode: st.postal } : {}), addressCountry: "CA" },
        ...(st.phone ? { telephone: st.phone } : {}), ...(st.website ? { url: st.website } : {}),
        ...(st.lat && st.lon ? { geo: { "@type": "GeoCoordinates", latitude: st.lat, longitude: st.lon } } : {}),
      },
    })),
  }] : []),
  ...(content?.faq?.length ? [faqLd(content.faq)] : []),
];
const varyCta = pick(city.slug + lang, lang === "en" ? ["See the full catalogue", "Browse every product", "Open the catalogue"] : ["Voir tout le catalogue", "Parcourir tous les produits", "Ouvrir le catalogue"]);
---
<Base lang={lang} title={L.title} description={L.desc} path={r.city(lang, provSlug(prov, lang), city.slug)} alt={r.city(other, provSlug(prov, other), city.slug)} jsonld={jsonld}>
  <section class="band border-b border-line">
    <div class="wrap grid gap-8 py-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:py-12">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1 class="mt-4">{L.h1}</h1>
        <p class="display mt-2 text-2xl text-mailbox">{L.kicker}</p>
        <p class="lede mt-4">{content?.lead ?? L.desc}</p>
      </div>
      <div class="parcel self-start">
        <p class="parcel-head">{L.label}</p>
        <dl class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-sm">
          <dt>{L.age}</dt><dd class="font-bold num">{prov.age}+</dd>
          <dt>{L.shipping}</dt><dd class="font-bold num">{activeShops.length}</dd>
          <dt>{L.storesL}</dt><dd class="font-bold num">{n}</dd>
          <dt>{L.grow}</dt><dd class="font-bold">{prov.homeGrow ? L.growYes : L.growNo}</dd>
        </dl>
        <a href={r.catalogue(lang)} class="btn-buy mt-4 w-full">{varyCta}</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <h2>{L.priceTitle}</h2>
      <p class="mt-1 text-sm text-muted">{L.priceNote} {s.updated(fmtDate(exportedAt, lang))}.</p>
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        {board.map(({ c, st }) => (
          <li><a href={r.category(lang, c)} class="flex h-full flex-col rounded-[4px] border border-line p-3 no-underline hover:border-ink">
            <span class="font-semibold">{CATEGORY_SLUGS[c].label[lang]}</span>
            <span class="mt-auto pt-2 text-xs text-muted">{s.from} <b class="display text-xl text-ink num">{price(st!.from)}</b></span>
          </a></li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2>{L.picksTitle}</h2>
      <div class="grid-products mt-6">{picks.map((p) => <ProductCard p={p} lang={lang} showCategory />)}</div>
    </section>

    <section id="stores" class="section">
      <h2>{L.storesTitle}</h2>
      {n > 0 ? (
        <>
          <p class="mt-1 text-sm text-muted">{L.storesNote} {sourceLinks.map(([n, u], i) => <>{i > 0 && ", "}<a href={u} rel="nofollow noopener" target="_blank">{n}</a></>)}</p>
          <ol class="mt-5 grid gap-3 md:grid-cols-2" data-stores>
            {city.stores.map((st, i) => (
              <li class:list={["rounded-[4px] border border-line p-4", i >= SHOW && "hidden"]} data-extra={i >= SHOW ? "1" : undefined}>
                <p class="font-semibold">{st.name}</p>
                <p class="mt-1 text-sm text-ink-soft">{st.address}{st.postal ? `, ${st.postal}` : ""}</p>
                <p class="mt-1 flex flex-wrap gap-x-4 text-sm">
                  {st.phone && <a href={`tel:${st.phone.replace(/[^0-9+]/g, "")}`}>{st.phone}</a>}
                  {st.website && <a href={st.website.startsWith("http") ? st.website : `https://${st.website}`} rel="nofollow noopener" target="_blank">{(() => { try { return new URL(st.website!.startsWith("http") ? st.website! : `https://${st.website}`).hostname.replace(/^www\./, ""); } catch { return L.web; } })()}</a>}
                </p>
              </li>
            ))}
          </ol>
          {n > SHOW && <button type="button" class="btn-ghost mt-4" onclick="document.querySelectorAll('[data-extra]').forEach(function(e){e.classList.remove('hidden')});this.remove()">{L.showAll(n)}</button>}
        </>
      ) : <p class="mt-3 max-w-[70ch]">{L.noStores}</p>}
    </section>

    <section class="section grid gap-12 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        {content ? (
        <article class="prose-bb">
          {content.sections.map((sec, i) => (<><h2 class:list={[i === 0 && "!mt-0"]}>{sec.h}</h2>{sec.p.map((x) => <p>{x}</p>)}</>))}
        </article>) : <div />}
        <aside class="parcel self-start">
          <p class="parcel-head">{L.rules}</p>
          <ul class="space-y-2 text-sm">
            <li>{lang === "en" ? `Legal age: ${prov.age}.` : `Âge légal : ${prov.age} ans.`}</li>
            <li>{lang === "en" ? "Possession in public: up to 30 g of dried cannabis (federal limit)." : "Possession en public : jusqu'à 30 g de cannabis séché (limite fédérale)."}</li>
            <li>{lang === "en" ? `Public use: ${prov.publicUse}.` : `Consommation en public : ${prov.publicUseFr}.`}</li>
            <li>{lang === "en" ? `Home growing: ${prov.homeGrow ? "allowed, up to 4 plants per household" : "not allowed"}.` : `Culture à domicile : ${prov.homeGrow ? "permise, jusqu'à 4 plants par résidence" : "interdite"}.`}</li>
            <li>{lang === "en" ? `Legal sales: ${prov.retailer}.` : `Vente légale : ${prov.retailerFr}.`}</li>
          </ul>
          <a href={r.province(lang, provSlug(prov, lang))} class="mt-3 inline-block text-sm font-semibold text-mailbox">{L.rulesMore}</a>
        </aside>
    </section>

    {content?.faq && <Faq items={content.faq} title={s.faqTitle} />}

    {near.length > 0 && (
      <section class="section">
        <h2>{L.near}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {near.map((c) => <li><a href={r.city(lang, provSlug(prov, lang), c.slug)} class="btn-ghost text-sm">{cityName(c, lang)}{c.stores.length ? <span class="ml-1 text-muted num">({c.stores.length})</span> : null}</a></li>)}
        </ul>
      </section>
    )}
  </div>
</Base>
