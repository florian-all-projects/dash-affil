---
// Index des guides.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { t, r, type Lang } from "../lib/i18n";
import { GUIDES } from "../data/guides";
import { guideContent } from "../lib/content";
import { breadcrumbLd } from "../lib/seo";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const en = lang === "en";
const other: Lang = en ? "fr" : "en";
const site = Astro.site!.toString().replace(/\/$/, "");
const list = GUIDES.map((g) => ({ g, c: guideContent(g.key, lang) })).filter((x) => x.c);
const crumbs = [{ name: s.breadcrumbHome, href: r.home(lang) }, { name: "Guides" }];
const h1 = en ? "Cannabis Buying Guides for Canada" : "Guides d'achat du cannabis au Canada";
---
<Base lang={lang} title={en ? "Cannabis Buying Guides: Weights, Grades, Edibles, Laws" : "Guides d'achat cannabis : poids, grades, comestibles, lois"} description={en ? "Short, chart-led guides built on this week's catalogue data: weights and prices, grades, indica vs sativa, edibles dosing, seeds and provincial laws." : "Des guides courts appuyés sur les données du catalogue de la semaine : poids et prix, grades, indica ou sativa, dosage des comestibles, graines et lois provinciales."} path={r.guides(lang)} alt={r.guides(other)} jsonld={[breadcrumbLd(site, crumbs)]}>
  <div class="wrap pt-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-4">{h1}</h1>
    <p class="lede mt-3">{en ? "Each guide pairs plain answers with charts drawn from the prices we check every week." : "Chaque guide associe des réponses claires à des graphiques tirés des prix vérifiés chaque semaine."}</p>
    <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {list.map(({ g, c }) => (
        <li class="panel flex flex-col">
          <a href={r.guide(lang, g.slug[lang])} class="panel-title no-underline hover:underline">{c!.h1}</a>
          <p class="mt-2 text-sm text-ink-soft">{c!.lead}</p>
          <a href={r.guide(lang, g.slug[lang])} class="mt-auto pt-4 text-sm font-semibold text-mailbox">{en ? "Read the guide" : "Lire le guide"}</a>
        </li>
      ))}
    </ul>
  </div>
</Base>
