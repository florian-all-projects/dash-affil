---
import Base from "../layouts/Base.astro";
import { t, r, fmtDate, type Lang } from "../lib/i18n";
import { CITIES, PROVINCES, LEGAL_SOURCE, LEGAL_VERIFIED, type Province } from "../data/geo";
interface Props { lang: Lang; prov: Province }
const { lang, prov } = Astro.props;
const s = t[lang];
const other: Lang = lang === "en" ? "fr" : "en";
const name = lang === "en" ? prov.name : prov.nameFr;
const cities = CITIES.filter((c) => c.province === prov.code);
const h1 = lang === "en" ? `Is weed legal in ${name}?` : `Le cannabis est-il légal : ${name} ?`;
const answer = lang === "en"
  ? `Yes. Adults ${prov.age} and older can buy, carry and use cannabis in ${name}, within limits. Legal sales go through ${prov.retailer}.`
  : `Oui. Les adultes de ${prov.age} ans et plus peuvent acheter, transporter et consommer du cannabis (${name}), dans certaines limites. La vente légale passe par ${prov.retailerFr}.`;
const rows = lang === "en"
  ? [
      ["Legal age", `${prov.age} and older`],
      ["Where to buy legally", prov.retailer],
      ["Public possession", "Up to 30 g of dried cannabis (federal limit)"],
      ["Home growing", prov.homeGrow ? "Allowed, up to 4 plants per household" : "Banned for non-medical use"],
      ["Public consumption", prov.publicUse],
    ]
  : [
      ["Âge légal", `${prov.age} ans et plus`],
      ["Où acheter légalement", prov.retailerFr],
      ["Possession en public", "Jusqu'à 30 g de cannabis séché (limite fédérale)"],
      ["Culture à domicile", prov.homeGrow ? "Permise, jusqu'à 4 plants par résidence" : "Interdite à des fins non médicales"],
      ["Consommation en public", prov.publicUseFr],
    ];
const mailOrder = lang === "en"
  ? "Online mail-order shops, including the ones compared on Budboard, are not licensed by any province. Buying from them is outside the legal retail system, even though possession of a legal amount is allowed. If you want a fully legal purchase, use the provincial channel above."
  : "Les boutiques de vente par correspondance, y compris celles comparées sur Budboard, ne détiennent aucune licence provinciale. Acheter chez elles se fait hors du circuit légal de vente au détail, même si la possession d'une quantité légale est permise. Pour un achat entièrement légal, passez par le canal provincial indiqué plus haut.";
const site = Astro.site!.toString().replace(/\/$/, "");
const jsonld = [{
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: [{ "@type": "Question", name: h1, acceptedAnswer: { "@type": "Answer", text: answer } }],
}];
---
<Base lang={lang} title={`${h1} | Budboard`} description={answer} path={r.province(lang, prov.slug, prov.slugFr)} alt={r.province(other, prov.slug, prov.slugFr)} jsonld={jsonld}>
  <div class="wrap pt-8">
    <h1 class="text-5xl md:text-6xl max-w-3xl">{h1}</h1>
    <p class="mt-5 text-xl max-w-2xl leading-relaxed">{answer}</p>
    <table class="mt-8 w-full max-w-3xl text-left">
      <tbody>
        {rows.map(([k, val]) => (
          <tr class="border-t border-lichen align-top"><th class="py-3 pr-6 font-semibold w-1/3">{k}</th><td class="py-3 text-moss">{val}</td></tr>
        ))}
      </tbody>
    </table>
    <div class="prose-bb mt-8"><p>{mailOrder}</p></div>
    <p class="mt-4 text-xs text-moss">{lang === "en" ? "Source:" : "Source :"} <a href={LEGAL_SOURCE} rel="nofollow noopener">Wikipedia</a>, {lang === "en" ? "checked" : "vérifié le"} {fmtDate(LEGAL_VERIFIED, lang)}. {lang === "en" ? "Rules change: check your province's official website before you buy." : "Les règles évoluent : vérifiez le site officiel de votre province avant d'acheter."}</p>

    {cities.length > 0 && (
      <section class="mt-10">
        <h2 class="text-3xl">{lang === "en" ? `Delivery prices in ${name}` : `Prix de livraison : ${name}`}</h2>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">{cities.map((c) => <li><a href={r.city(lang, c.slug)}>{lang === "en" ? c.name : c.nameFr}</a></li>)}</ul>
      </section>
    )}
    <section class="mt-10">
      <h2 class="text-3xl">{lang === "en" ? "Other provinces and territories" : "Autres provinces et territoires"}</h2>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {PROVINCES.filter((p) => p.code !== prov.code).map((p) => <li><a href={r.province(lang, p.slug, p.slugFr)}>{lang === "en" ? p.name : p.nameFr}</a></li>)}
      </ul>
    </section>
  </div>
</Base>
