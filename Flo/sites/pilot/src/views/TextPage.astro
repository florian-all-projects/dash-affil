---
// Pages éditoriales : méthode (about) et guide d'achat en ligne (guide). Texte rédigé à la main, EN et FR.
import Base from "../layouts/Base.astro";
import { r, type Lang } from "../lib/i18n";
import { products, shops, productsByShop } from "../lib/catalog";
interface Props { lang: Lang; kind: "about" | "guide" }
const { lang, kind } = Astro.props;
const other: Lang = lang === "en" ? "fr" : "en";
const nShops = shops.filter((s) => productsByShop(s.slug).length).length;
const pages = {
  about: {
    path: r.about,
    en: {
      title: "How Budboard compares weed prices",
      lede: "A plain explanation of where our prices come from, what we leave out and how we make money.",
      sections: [
        ["Where the prices come from", [`Every week a program reads the public product catalogue of ${nShops} Canadian online shops and records each product's price and stock. ${products.length} products are in stock in the current check.`, "When the same product is sold by several shops, it gets one page with every price side by side. The price shown is the lowest one, for the smallest format."]],
        ["What we leave out", ["We list cannabis, CBD, seeds and accessories only. Some shops also sell other substances; we do not list them.", "We do not publish ratings, reviews or testimonials. A shop page shows facts we can check: its catalogue, its prices and its promo codes."]],
        ["How Budboard makes money", ["Buy buttons are affiliate links. When you order through them, the shop pays Budboard a commission. Your price stays the same.", "When a product has several sellers, the main button can point to a partner shop that is not the cheapest. The comparison table on every product page always lists every seller from the lowest price up."]],
        ["About the law", ["Cannabis is legal for adults in Canada, but legal retail sales go through retailers authorized by each province or territory. The mail-order shops compared here do not hold provincial licences. Our province pages explain the rules where you live."]],
      ],
    },
    fr: {
      title: "Comment Budboard compare les prix du cannabis",
      lede: "D'où viennent nos prix, ce que nous laissons de côté et comment nous gagnons de l'argent.",
      sections: [
        ["D'où viennent les prix", [`Chaque semaine, un programme lit le catalogue public de ${nShops} boutiques en ligne canadiennes et note le prix et le stock de chaque produit. ${products.length} produits sont en stock dans le relevé actuel.`, "Quand un même produit est vendu par plusieurs boutiques, il a une seule fiche avec tous les prix côte à côte. Le prix affiché est le plus bas, pour le plus petit format."]],
        ["Ce que nous laissons de côté", ["Nous listons uniquement le cannabis, le CBD, les graines et les accessoires. Certaines boutiques vendent aussi d'autres substances : nous ne les listons pas.", "Nous ne publions ni notes, ni avis, ni témoignages. Une fiche boutique montre des faits vérifiables : son catalogue, ses prix et ses codes promo."]],
        ["Comment Budboard gagne de l'argent", ["Les boutons d'achat sont des liens affiliés. Quand vous commandez par eux, la boutique verse une commission à Budboard. Votre prix ne change pas.", "Quand un produit a plusieurs vendeurs, le bouton principal peut mener à une boutique partenaire qui n'est pas la moins chère. Le tableau de comparaison de chaque fiche liste toujours tous les vendeurs, du prix le plus bas au plus haut."]],
        ["La loi", ["Le cannabis est légal pour les adultes au Canada, mais la vente au détail légale passe par les détaillants autorisés de chaque province ou territoire. Les boutiques de vente par correspondance comparées ici n'ont pas de licence provinciale. Nos pages par province expliquent les règles chez vous."]],
      ],
    },
  },
  guide: {
    path: r.guide,
    en: {
      title: "How to buy weed online in Canada",
      lede: "What actually happens when you order cannabis online, and what to check before you pay.",
      sections: [
        ["Two very different ways to order", ["Your province's authorized retailer sells online and delivers legally. Prices and selection are set by the province.", "Mail-order shops (often called MOMs) sell to the whole country by post. They usually have more choice and lower prices, but they are not licensed by any province, so you buy outside the legal retail system."]],
        ["Compare the real price", ["Look at the price for the format you want, not only the smallest one. Ounces and half ounces often cost much less per gram.", "Add shipping and check the minimum order. A cheaper product can cost more once delivered."]],
        ["Before you pay", ["Check the legal age and limits in your province. You can carry up to 30 grams of dried cannabis in public.", "Read the shop's shipping and refund policy. Keep your order confirmation.", "Promo codes are entered at checkout on the shop's site. Our coupon pages show which codes are personal and which are public."]],
        ["Use your judgement", ["Start low with edibles: they take longer to act and last longer than smoking. This guide is not medical advice."]],
      ],
    },
    fr: {
      title: "Comment acheter du cannabis en ligne au Canada",
      lede: "Ce qui se passe vraiment quand on commande du cannabis en ligne, et ce qu'il faut vérifier avant de payer.",
      sections: [
        ["Deux façons très différentes de commander", ["Le détaillant autorisé de votre province vend en ligne et livre légalement. Les prix et le choix sont fixés par la province.", "Les boutiques de vente par correspondance (souvent appelées MOM) vendent partout au pays par la poste. Elles ont souvent plus de choix et des prix plus bas, mais aucune province ne leur accorde de licence : l'achat se fait hors du circuit légal."]],
        ["Comparer le vrai prix", ["Regardez le prix du format qui vous intéresse, pas seulement le plus petit. L'once et la demi-once reviennent souvent bien moins cher au gramme.", "Ajoutez les frais de port et vérifiez le minimum de commande. Un produit moins cher peut coûter plus une fois livré."]],
        ["Avant de payer", ["Vérifiez l'âge légal et les limites de votre province. On peut transporter jusqu'à 30 grammes de cannabis séché en public.", "Lisez la politique de livraison et de remboursement de la boutique. Gardez votre confirmation de commande.", "Les codes promo se saisissent au moment de payer, sur le site de la boutique. Nos pages codes promo indiquent quels codes sont personnels et lesquels sont publics."]],
        ["Restez prudent", ["Avec les comestibles, commencez par une petite dose : l'effet arrive plus tard et dure plus longtemps qu'en fumant. Ce guide ne remplace pas un avis médical."]],
      ],
    },
  },
}[kind];
const c = pages[lang];
---
<Base lang={lang} title={`${c.title} | Budboard`} description={c.lede} path={pages.path(lang)} alt={pages.path(other)}>
  <article class="wrap pt-8">
    <h1 class="text-5xl md:text-6xl max-w-3xl">{c.title}</h1>
    <p class="mt-4 text-xl max-w-2xl leading-relaxed text-moss">{c.lede}</p>
    {c.sections.map(([h, paras]) => (
      <section class="mt-10">
        <h2 class="text-3xl">{h}</h2>
        <div class="prose-bb mt-3">{(paras as string[]).map((p) => <p>{p}</p>)}</div>
      </section>
    ))}
    {kind === "guide" && (
      <p class="mt-10"><a class="btn-buy" href={r.menu(lang)}>{lang === "en" ? "Compare prices on the menu" : "Comparer les prix dans le menu"}</a></p>
    )}
  </article>
</Base>
