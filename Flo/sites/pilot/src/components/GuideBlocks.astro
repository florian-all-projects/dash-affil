---
// Texte éditorial présenté en fiches courtes plutôt qu'en bloc : une carte par section, la première phrase-clé visible,
// le reste replié. Les chiffres de la section sont repris en gras pour être lus en diagonale.
import type { PageText } from "../lib/content";
interface Props { sections: PageText["sections"]; title?: string; lang: "en" | "fr"; cols?: 2 | 3 }
const { sections, title, lang, cols = 2 } = Astro.props;
const bold = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/(\$\s?\d[\d,.]*|\d[\d\s,.]*\s?\$|\d+(?:[.,]\d+)?\s?(?:%|g\b|mg\b|grams?\b|grammes?\b|shops?\b|boutiques?\b|products?\b|produits?\b|stores?\b|magasins?\b))/g, "<b>$1</b>");
---
{sections.length > 0 && (
  <section class="section">
    {title && <h2>{title}</h2>}
    <div class:list={["mt-5 grid gap-4", cols === 3 ? "md:grid-cols-2 lg:grid-cols-3" : "md:grid-cols-2"]}>
      {sections.map((sec) => (
        <article class="panel">
          <h3 class="panel-title !text-[1.25rem]">{sec.h}</h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft" set:html={bold(sec.p[0] ?? "")} />
          {sec.p.length > 1 && (
            <details class="group mt-2">
              <summary class="cursor-pointer list-none text-sm font-semibold text-mailbox group-open:hidden">{lang === "en" ? "Read more" : "Lire la suite"}</summary>
              {sec.p.slice(1).map((x) => <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft" set:html={bold(x)} />)}
            </details>
          )}
        </article>
      ))}
    </div>
  </section>
)}
