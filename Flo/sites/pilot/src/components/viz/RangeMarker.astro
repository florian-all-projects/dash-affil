---
// Position d'une valeur dans la distribution de sa catégorie : bande des 10e-90e centiles, médiane, point pour ce produit.
// Exemple : prix au gramme de cette fleur face à toutes les fleurs du catalogue.
interface Props { values: number[]; value: number; fmt: (v: number) => string; lowLabel: string; highLabel: string; markerLabel: string; medianLabel: string }
const { values, value, fmt, lowLabel, highLabel, markerLabel, medianLabel } = Astro.props;
const sorted = [...values].sort((a, b) => a - b);
const q = (p: number) => sorted[Math.min(sorted.length - 1, Math.max(0, Math.round(p * (sorted.length - 1))))];
const lo = q(0.05), hi = q(0.95), med = q(0.5);
const span = hi - lo || 1;
const pos = (v: number) => Math.min(100, Math.max(0, ((v - lo) / span) * 100));
const p10 = pos(q(0.1)), p90 = pos(q(0.9));
---
<div class="pt-7 pb-1" title={`${markerLabel}: ${fmt(value)} · ${medianLabel}: ${fmt(med)}`}>
  <div class="relative h-3 rounded-[2px] bg-track">
    <div class="absolute inset-y-0 rounded-[2px] bg-[#c9d3ea]" style={`left:${p10}%;right:${100 - p90}%`}></div>
    <div class="absolute -top-1 -bottom-1 w-px bg-ink-soft" style={`left:${pos(med)}%`}></div>
    <div class="absolute top-1/2 size-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-mailbox shadow-[0_0_0_1px_var(--color-mailbox)]" style={`left:${pos(value)}%`}></div>
    <div class="absolute -top-7 -translate-x-1/2 whitespace-nowrap text-xs font-semibold" style={`left:${Math.min(88, Math.max(12, pos(value)))}%`}>{markerLabel} {fmt(value)}</div>
  </div>
  <div class="mt-2 flex justify-between text-xs text-muted num"><span>{lowLabel} {fmt(lo)}</span><span>{medianLabel} {fmt(med)}</span><span>{highLabel} {fmt(hi)}</span></div>
</div>
