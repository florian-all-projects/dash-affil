---
import { t, r, fmtPrice, CATEGORY_SLUGS, type Lang } from "../lib/i18n";
import type { Product } from "../lib/catalog";
import { SHORT_NAME } from "../data/shops-content";
interface Props { p: Product; lang: Lang; showCategory?: boolean }
const { p, lang, showCategory = false } = Astro.props;
const s = t[lang];
const typeLabel = p.strainType ? (lang === "fr" && p.strainType === "hybrid" ? "hybride" : p.strainType) : null;
---
<li class="menu-row">
  <div class="min-w-0">
    <a href={r.product(lang, p.slug)} class="font-semibold text-spruce hover:text-leaf">{p.name}</a>
    <div class="mt-1 flex flex-wrap items-center gap-1.5 text-xs text-moss">
      {typeLabel && <span class={`chip chip-${p.strainType}`}>{typeLabel}</span>}
      {showCategory && <span class="chip">{CATEGORY_SLUGS[p.category]?.label[lang]}</span>}
      {p.weights.length > 0 && <span class="truncate">{p.weights.slice(0, 5).join(", ")}</span>}
    </div>
  </div>
  <div class="text-right md:text-left num">
    <span class="text-xs text-moss">{s.from}</span>
    <span class="display text-xl text-copper"> {fmtPrice(p.from, lang)}</span>
    {p.discount > 0 && <span class="block text-xs text-leaf">−{p.discount}%</span>}
  </div>
  <div class="hidden md:block text-sm text-moss">{s.shopsCount(p.shopCount)}</div>
  <div class="col-span-2 md:col-span-1 md:text-right">
    <a class="btn-buy text-sm w-full md:w-auto" href={p.primary.buyUrl} rel="sponsored nofollow noopener" target="_blank">{s.buyAt(SHORT_NAME[p.primary.shop.slug] ?? p.primary.shop.name)}</a>
  </div>
</li>
