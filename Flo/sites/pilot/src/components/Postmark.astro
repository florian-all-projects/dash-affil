---
// Signature 2 : cachet postal rond portant la date de l'édition (= date du dernier relevé des prix).
interface Props { top: string; date: string; bottom: string; size?: number; class?: string }
const { top, date, bottom, size = 132, class: cls = "" } = Astro.props;
// Identifiant stable (builds reproductibles) dérivé du texte du cachet
let h = 0;
for (const ch of top + date + bottom) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const id = `pm-${h.toString(36)}`;
---
<svg class={cls} width={size} height={size} viewBox="0 0 140 140" role="img" aria-label={`${top} ${date}`}>
  <defs>
    <path id={`${id}-t`} d="M 22 70 A 48 48 0 0 1 118 70" />
    <path id={`${id}-b`} d="M 18 70 A 52 52 0 0 0 122 70" />
  </defs>
  <g fill="none" stroke="currentColor">
    <circle cx="70" cy="70" r="66" stroke-width="3" />
    <circle cx="70" cy="70" r="58" stroke-width="1.5" />
    <line x1="22" y1="58" x2="118" y2="58" stroke-width="1.5" />
    <line x1="22" y1="84" x2="118" y2="84" stroke-width="1.5" />
  </g>
  <g fill="currentColor" font-family="Public Sans, sans-serif" font-weight="700" font-size="10" letter-spacing="1.5">
    <text><textPath href={`#${id}-t`} startOffset="50%" text-anchor="middle">{top}</textPath></text>
    <text><textPath href={`#${id}-b`} startOffset="50%" text-anchor="middle" dominant-baseline="hanging">{bottom}</textPath></text>
  </g>
  <text x="70" y="77" text-anchor="middle" fill="currentColor" font-family="Big Shoulders Display, sans-serif" font-weight="800" font-size="17" letter-spacing="0.5">{date}</text>
</svg>
