---
import "../styles/global.css";
import { t, r, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;          // chemin de la page courante
  alt?: string | null;   // chemin de la page équivalente dans l'autre langue
  jsonld?: object[];
}
const { lang, title, description, path, alt = null, jsonld = [] } = Astro.props;
const s = t[lang];
const site = Astro.site!.toString().replace(/\/$/, "");
const other: Lang = lang === "en" ? "fr" : "en";
const altPath = alt ?? r.home(other);
const enPath = lang === "en" ? path : alt;
const frPath = lang === "fr" ? path : alt;
const navItems = [
  { href: r.menu(lang), label: s.nav.menu },
  { href: r.cities(lang), label: s.nav.cities },
  { href: r.shops(lang), label: s.nav.shops },
  { href: r.coupons(lang), label: s.nav.coupons },
  { href: r.guide(lang), label: s.nav.guide },
];
---
<!doctype html>
<html lang={lang === "en" ? "en-CA" : "fr-CA"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Site pilote sur adresse provisoire : pas d'indexation tant que le NDD définitif n'est pas branché. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={site + path} />
    {enPath && <link rel="alternate" hreflang="en-CA" href={site + enPath} />}
    {frPath && <link rel="alternate" hreflang="fr-CA" href={site + frPath} />}
    {enPath && <link rel="alternate" hreflang="x-default" href={site + enPath} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "en" ? "en_CA" : "fr_CA"} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-paper px-3 py-2 z-50">Skip to content</a>
    <header class="bg-spruce text-mist">
      <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-2 py-3">
        <a href={r.home(lang)} class="display text-2xl text-mist no-underline flex items-center gap-2" aria-label={s.siteName}>
          <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><rect x="1" y="1" width="24" height="24" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M7 17h12M7 13h8M7 9h10" stroke="#d9a77a" stroke-width="2.4" stroke-linecap="round"/></svg>
          {s.siteName}
        </a>
        <nav class="order-3 w-full md:order-none md:w-auto md:flex-1" aria-label="Main">
          <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
            {navItems.map((n) => (
              <li><a href={n.href} class:list={["no-underline hover:underline", path.startsWith(n.href) ? "text-copper-light" : "text-mist/90"]}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a href={altPath} hreflang={other} lang={other} class="ml-auto text-sm text-mist/90 border border-mist/30 rounded-[var(--radius-chip)] px-2 py-1 no-underline hover:border-mist">{s.langSwitch}</a>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="bg-spruce-deep text-mist/80 text-sm mt-16">
      <div class="wrap py-10 grid gap-6 md:grid-cols-3">
        <div>
          <p class="display text-xl text-mist">{s.siteName}</p>
          <p class="mt-2">{s.tagline}</p>
        </div>
        <p class="md:col-span-2">{s.disclosure} {s.footerLegal}</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-1 md:col-span-3">
          <li><a class="text-mist/90" href={r.about(lang)}>{lang === "en" ? "How we compare prices" : "Notre méthode"}</a></li>
          <li><a class="text-mist/90" href={r.guide(lang)}>{s.nav.guide}</a></li>
          <li><a class="text-mist/90" href={r.cities(lang)}>{s.nav.cities}</a></li>
        </ul>
      </div>
    </footer>

    <dialog id="age-gate" class="m-auto max-w-md rounded-lg p-0 backdrop:bg-spruce/80" aria-labelledby="age-title">
      <div class="bg-paper p-6">
        <p id="age-title" class="display text-3xl">{s.ageTitle}</p>
        <p class="mt-3 leading-relaxed">{s.ageBody}</p>
        <div class="mt-6 flex gap-3">
          <button type="button" class="btn-buy" data-age-yes>{s.ageYes}</button>
          <a class="inline-flex items-center px-3 text-moss" href="https://www.canada.ca/en/health-canada/services/drugs-medication/cannabis.html">{s.ageNo}</a>
        </div>
      </div>
    </dialog>
    <script is:inline>
      (function () {
        var ok = false;
        try { ok = localStorage.getItem("bb-age") === "1"; } catch (e) {}
        var d = document.getElementById("age-gate");
        if (!ok && d && d.showModal) {
          d.showModal();
          d.addEventListener("cancel", function (e) { e.preventDefault(); });
          d.querySelector("[data-age-yes]").addEventListener("click", function () {
            try { localStorage.setItem("bb-age", "1"); } catch (e) {}
            d.close();
          });
        }
      })();
    </script>
  </body>
</html>
