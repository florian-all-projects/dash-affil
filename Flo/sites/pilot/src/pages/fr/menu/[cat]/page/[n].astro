---
import Category from "../../../../../views/Category.astro";
import { CATEGORY_SLUGS, CATEGORY_ORDER } from "../../../../../lib/i18n";
import { productsByCategory } from "../../../../../lib/catalog";
export function getStaticPaths() {
  return CATEGORY_ORDER.flatMap((c) => {
    const all = productsByCategory(c);
    const pages = Math.ceil(all.length / 50);
    return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => i + 2).map((n) => ({
      params: { cat: CATEGORY_SLUGS[c].fr, n: String(n) },
      props: { c, n, items: all.slice((n - 1) * 50, n * 50), pages },
    }));
  });
}
const { c, n, items, pages } = Astro.props;
---
<Category lang="fr" cat={c} page={n} items={items} pages={pages} />
