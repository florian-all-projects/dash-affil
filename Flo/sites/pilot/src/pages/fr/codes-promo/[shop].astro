---
import ShopPage from "../../../views/ShopPage.astro";
import { shops, productsByShop } from "../../../lib/catalog";
export function getStaticPaths() { return shops.filter((s) => productsByShop(s.slug).length).map((shop) => ({ params: { shop: shop.slug }, props: { shop } })); }
const { shop } = Astro.props;
---
<ShopPage lang="fr" shop={shop} mode="coupon" />
